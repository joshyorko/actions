+def _owned_identity_census(psutil_module, captured):
+    """Data-only uncapped final enumeration; unknown identities stay unknown."""
+    report = {"final_owned_children": [], "captured_identity_states": [],
+              "errors": [], "complete": False}
+    try:
+        for process in _supervisor_children(psutil_module):
+            report["final_owned_children"].append(
+                {"pid": process.pid, "create_time": process.create_time(),
+                 "status": process.status()})
+        for identity in captured:
+            pid, epoch = identity
+            state = "UNKNOWN"
+            try:
+                process = psutil_module.Process(pid)
+                if process.create_time() != epoch:
+                    state = "REUSED_PID"
+                else:
+                    state = "ZOMBIE" if process.status() == psutil_module.STATUS_ZOMBIE else "LIVE"
+            except psutil_module.NoSuchProcess:
+                state = "ABSENT"
+            except psutil_module.Error:
+                report["errors"].append("CAPTURED_IDENTITY_INSPECTION_UNAVAILABLE")
+            report["captured_identity_states"].append(
+                {"pid": pid, "create_time": epoch, "state": state})
+        report["complete"] = not report["errors"]
+    except psutil_module.Error:
+        report["errors"].append("FINAL_ENUMERATION_UNAVAILABLE")
+    return report
