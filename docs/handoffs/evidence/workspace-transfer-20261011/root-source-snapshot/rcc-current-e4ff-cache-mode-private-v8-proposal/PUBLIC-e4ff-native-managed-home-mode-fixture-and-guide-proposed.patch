+        _prepare_owned_rcc_test_package_cache(case, "v18.19.3", value["binary_sha256"])[
+            "cold_first_publication"
+        ]
+        is True
+    )
+    published()
+    original_stat = Path.stat
+
+    def controlled_stat(path, *args, **kwargs):
+        metadata = original_stat(path, *args, **kwargs)
+        if path == client:
