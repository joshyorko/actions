+):
+    (
+        root,
+        case,
+        managed,
+        value,
+        configure,
+        publication,
+        published,
+    ) = owned_rcc_package_cache_control
+    assert (
+        _prepare_owned_rcc_test_package_cache(case, "v18.19.3", value["binary_sha256"])[
+            "cold_first_publication"
+        ]
+        is True
+    )
+    published()
+    client = root / "actions-home"
+    client.chmod(mode)
