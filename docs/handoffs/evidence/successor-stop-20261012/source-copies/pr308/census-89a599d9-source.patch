+    waits = []
+    lookups = []
+
+    class ProcessError(Exception):
+        pass
+
+    class Missing(ProcessError):
+        pass
+
+    class Child:
+        pid = 1
+        returncode = None
+
+        def __init__(self, *_args, **kwargs):
+            kwargs["stdout"].write(b"command-out")
+            kwargs["stderr"].write(b"command-err")
+
+        def poll(self):
+            polls.append(True)
+            if len(polls) > (2 if opt_in else 0):
+                self.returncode = 0
+            return self.returncode
+
+        def wait(self, timeout=None):
+            waits.append(timeout)
+            assert self.returncode == 0
+            return self.returncode
+
+    child = Child.__new__(Child)
+
+    def create_child(*args, **kwargs):
+        child.__init__(*args, **kwargs)
+        return child
+
+    class Process:
+        def create_time(self):
+            return 1.0
+
+        def children(self, recursive=True):
+            return []
+
+    def lookup(pid):
+        lookups.append(pid)
+        if pid == 1 and child.returncode is not None:
+            raise Missing()
+        return Process()
+
+    class Scratch:
+        def __enter__(self):
+            return str(tmp_path)
+
+        def __exit__(self, *_args):
+            pass
+
+    request = {
+        "command": ["unused"],
+        "cwd": None,
+        "env": {},
+        "timeout_seconds": 1,
+        "cleanup_grace_seconds": 1,
+    }
