+    with pytest.raises(SystemExit) as stopped:
+        _main_retcode(["-h"])
+    assert stopped.value.code == 0
+    output = (
+        capsys.readouterr()
+        .out.replace(f"Actions Runtime ({__version__})", "Actions Runtime (<version>)")
+        .strip()
+    )
+    assert (
+        output
+        == (Path(__file__).parent / "test_cli" / "test_help_-h.txt").read_text().strip()
+    )
