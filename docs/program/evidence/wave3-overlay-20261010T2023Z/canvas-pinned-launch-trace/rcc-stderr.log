# Repository developer toolkit.
#
# RCC owns the reproducible toolchain and task boundary. Poetry remains the
# dependency and package-release authority inside each package.

tasks:
  Doctor:
    shell: python toolkit.py doctor

devTasks:
  Doctor:
    shell: python toolkit.py doctor
  Bootstrap:
    shell: python toolkit.py bootstrap
  Test:
    shell: python toolkit.py test
  ToolkitTest:
    shell: python toolkit.py toolkit-test
  Lint:
    shell: python toolkit.py lint
  Typecheck:
    shell: python toolkit.py typecheck
  Docs:
    shell: python toolkit.py docs
  CheckAll:
    shell: python toolkit.py check-all
  Coverage:
    shell: python toolkit.py coverage
  FrontendTest:
    shell: python toolkit.py frontend-test
  InstallCommunity:
    shell: python toolkit.py install-community

environmentConfigs:
  - setup_windows_amd64.yaml
  - setup.yaml

artifactsDir: tmp

PATH:
  - .
PYTHONPATH:
  - .
ignoreFiles:
  - ../.gitignore

