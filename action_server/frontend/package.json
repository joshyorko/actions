{
  "name": "actions-runtime-frontend",
  "description": "",
  "version": "0.0.1",
  "private": true,
  "engines": { "node": ">=20.19.0" },
  "copyright": "Copyright 2024 Josh Yorko",
  "license": "Apache-2.0",
  "main": "index.js",
  "type": "module",
  "author": {
    "name": "Josh Yorko",
    "email": "josh@example.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:runtime",
    "build:runtime": "vite build --mode runtime --minify=esbuild && node scripts/inline-runtime-assets.mjs && node scripts/write-artifact-manifest.mjs dist runtime-admin text/html && npm run sbom:runtime",
    "build:canvas": "vite build --mode canvas --minify=esbuild && node scripts/write-artifact-manifest.mjs dist-canvas canvas-mcp-app \"text/html;profile=mcp-app\" && npm run sbom:canvas",
    "build:artifacts": "npm run build:runtime && npm run build:canvas",
    "build:debug": "vite build --mode runtime --minify=false",
    "build:tests": "vite build --mode runtime --minify=false --outDir=./dist-test",
    "test:lint": "eslint --max-warnings 0 apps/runtime/src apps/canvas-view/src src/app",
    "test:types": "tsc --noEmit",
    "test:prettier": "prettier --end-of-line auto --check apps/runtime/src apps/canvas-view/src src/app",
    "prettier": "prettier --write ./src/**/*.{ts,tsx}",
    "fixlint": "eslint --fix --ext .tsx,.ts .",
    "test": "vitest --run",
    "test:topology": "vitest --run --testNamePattern \"Actions frontend topology\"",
    "test:quality": "npm run test:lint && npm run test:types && npm run test:prettier && npm run test:topology",
    "validate:artifacts": "node scripts/validate-artifacts.mjs",
    "sbom:runtime": "cyclonedx-npm --output-format json --output-reproducible --output-file dist/sbom.json",
    "sbom:canvas": "cyclonedx-npm --output-format json --output-reproducible --output-file dist-canvas/sbom.json",
    "sbom": "cyclonedx-npm --output-format json --output-reproducible --output-file dist/sbom.json && cyclonedx-npm --output-format json --output-reproducible --output-file dist-canvas/sbom.json"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.10.0",
    "@codemirror/legacy-modes": "^6.3.3",
    "@codemirror/view": "^6.28.1",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-slot": "^1.0.2",
    "@tanstack/react-query": "^5.28.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^2.30.0",
    "openapi-types": "^12.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^6.21.3",
    "recharts": "^2.15.4",
    "styled-components": "^6.1.11",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.1.2",
    "@types/node": "^20.11.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/styled-components": "^5.1.26",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.5",
    "@eslint/js": "^9.39.5",
    "postcss": "^8.4.33",
    "prettier": "^3.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "jsdom": "^26.1.0",
    "axe-core": "^4.10.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "esbuild": "^0.28.2",
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/user-event": "^14.5.0"
  }
}
