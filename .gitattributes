# Set the default behavior, in case people don't have `core.autocrlf` set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native OS line endings on checkout, but committing those with LF in the repo.
*.py text
*.js text
*.md text

# Migration source is a byte-level historical contract; preserve LF on every OS.
action_server/src/actions/server/migrations/*.py text eol=lf

# These archive payloads are checked byte-for-byte against their manifests.
# Do not apply text checkout conversion to their committed evidence bytes.
docs/program/evidence/canvas-execution-graph-amendment-20261009-v* -text

# This byte-verified generated resource intentionally retains its proven build bytes.
templates/canvas-query/canvas.html -whitespace linguist-generated

# Native provenance hashes these Go inputs as exact source bytes on every OS.
action_server/go-wrapper/main.go text eol=lf
action_server/go-wrapper/process.go text eol=lf
action_server/go-wrapper/go.mod text eol=lf
action_server/go-wrapper/go.sum text eol=lf

# Package Revision fixtures assert canonical JSON bytes, including LF endings.
docs/design/fixtures/package-revision-v1/*.json text eol=lf
