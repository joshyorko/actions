{
  "schemaVersion": "actions.canvas-spec/v1",
  "title": "Local catalog",
  "visibility": ["model", "app"],
  "bindingIds": ["search"],
  "root": {
    "type": "stack",
    "id": "main",
    "children": [
      {
        "type": "text",
        "id": "intro",
        "text": "Search the local example catalog."
      },
      {
        "type": "form",
        "id": "search-form",
        "bindingId": "search",
        "submitLabel": "Search",
        "fields": [
          {
            "name": "query",
            "label": "Search terms",
            "type": "text",
            "required": true
          }
        ]
      },
      {
        "type": "table",
        "id": "results",
        "bindingId": "search",
        "rowsKey": "items",
        "columns": [
          { "key": "name", "label": "Name" },
          { "key": "category", "label": "Category" }
        ]
      },
      { "type": "status", "id": "search-status", "bindingId": "search" }
    ]
  }
}
