  "differences": [
    {
      "id": "state.done-value",
      "classification": "required_parity",
      "decision": "State.DONE.value is COMPLETED; readers accept DONE and COMPLETED",
      "status": "expected_red",
      "task": "task-2"
    },
    {
      "id": "adapter.protocol-split",
      "classification": "required_parity",
      "decision": "RuntimeAdapter has nine processing methods and ManagedAdapter has six management methods",
      "status": "expected_red",
      "task": "task-2"
    },
    {
      "id": "signature.release-input",
      "classification": "required_parity",
      "decision": "Accept upstream exception object and 0.3.1 split exception keywords through typed overloads",
      "status": "expected_red",
      "task": "task-2"
    },
    {
      "id": "signature.add-file",
      "classification": "required_parity",
      "decision": "Accept three-argument upstream and four-argument 0.3.1 forms",
      "status": "expected_red",
      "task": "task-2"
    },
    {
      "id": "runtime.lifecycle",
      "classification": "required_parity",
      "decision": "Restore upstream current/released/output/context/task lifecycle",
      "status": "expected_red",
      "task": "task-2"
    },
    {
      "id": "runtime.email",
      "classification": "required_parity",
      "decision": "Restore upstream payload email parser and __mail.html behavior",
      "status": "expected_red",
      "task": "task-2"
    },
    {
      "id": "file.direct-mode",
      "classification": "required_parity",
      "decision": "Existing file or .json path selects upstream direct-file representation",
      "status": "expected_red",
      "task": "task-3"
    },
    {
      "id": "file.directory-mode",
      "classification": "preserved_0_3_1_compatibility",
      "decision": "Existing directory or non-JSON path preserves envelope and item-owned files",
      "status": "implemented",
      "task": "task-3"
    },
    {
      "id": "file.path-containment",
      "classification": "intentional_security_hardening",
      "decision": "Reject absolute, traversal, separator, quote, control, and symlink escapes in both modes",
      "status": "implemented",
      "task": "task-3"
    },
    {
      "id": "sqlite.atomic-claim",
      "classification": "preserved_0_3_1_compatibility",
      "decision": "BEGIN IMMEDIATE, conditional FIFO claim, deterministic rowid tie break",
      "status": "implemented",
      "task": "task-4"
    },
    {
      "id": "sqlite.historical-migrations",
      "classification": "required_parity",
      "decision": "Open custom 0.1.6 and actions 0.3.1 schemas transactionally and idempotently",
      "status": "expected_red",
      "task": "task-4"
    },
    {
      "id": "redis.contract",
      "classification": "required_parity",
      "decision": "Preserve custom keys, TTL, origins, routing, atomic reservation, recovery, and attachments",
      "status": "expected_red",
      "task": "task-4"
    },
    {
      "id": "mongodb.contract",
      "classification": "required_parity",
      "decision": "Preserve custom documents, indexes, atomic claim, routing, recovery, and inline/GridFS attachments",
      "status": "expected_red",
      "task": "task-4"
    },
    {
      "id": "aws-documentdb.live",
      "classification": "unsupported_external_service",
      "decision": "AWS DocumentDB-specific behavior remains unverified and experimental",
      "status": "unsupported_external_service",
      "task": "task-4"
    },
    {
      "id": "robocorp-control-room",
      "classification": "unsupported_external_service",
      "decision": "Official Robocorp Control Room HTTP adapter is excluded",
      "status": "unsupported_external_service",
      "task": "none"
    },
    {
      "id": "yorko.live",
      "classification": "unsupported_external_service",
      "decision": "Yorko remains optional and experimental until a live gate exists",
      "status": "unsupported_external_service",
      "task": "task-5"
    },
    {
      "id": "aliases",
      "classification": "preserved_0_3_1_compatibility",
      "decision": "Preserve actions.work_items, actions.workitems, actions_work_items, and from actions import workitems",
      "status": "implemented",
      "task": "task-2"
    },
    {
      "id": "management-api",
      "classification": "preserved_0_3_1_compatibility",
      "decision": "Preserve seed/list/get/delete/stats/recovery for managed adapters and Action Server",
      "status": "implemented",
      "task": "task-2"
    }
  ]
